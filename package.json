{
  "name": "simple-calculator",
  "version": "1.0.1",
  "description": "一个简单的计算器 CLI 工具，支持加减乘除基本运算",
  "main": "lib/calculator.js",
  "bin": {
    "calculator": "./bin/calculator.js",
    "calc": "./bin/calculator.js"
  },
  "scripts": {
    "start": "node bin/calculator.js",
    "test": "node test/sdk-test.js",
    "lint": "eslint . --ignore-pattern node_modules/ --ignore-pattern test-result/ || echo 'ESLint not configured, skipping'",
    "prepare": "husky install"
  },
  "keywords": [
    "calculator",
    "cli",
    "math",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "open": "^8.4.2"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "bin/",
    "lib/",
    "src/"
  ],
  "lint-staged": {
    "*.js": [
      "npm run lint",
      "npm test"
    ],
    "*.{json,md}": [
      "echo 'Checking file format...'"
    ]
  }
}
